<?xml version="1.0"?>

<robot name="joints_practice_bot">

  <material name="polished_gold">
    <!-- Warm, deep metallic gold instead of flat yellow -->
    <color rgba="0.85 0.65 0.15 1.0" />
  </material>

  <material name="anodized_crimson">
    <!-- Deep, rich metallic red -->
    <color rgba="0.65 0.05 0.10 1.0" />
  </material>

   <!-- Dark Cream Blue Metallic Material -->
  <material name="dark_cream_blue_metallic">
    <!-- A deeper, richer steel-toned slate blue with a premium metallic look -->
    <color rgba="0.45 0.58 0.68 1.0" />
  </material>


    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>    
            </geometry>
            <origin xyz="0 0 0.1" rpy=" 0 0 0"/>  
            <material name="anodized_crimson">
            </material>             
        </visual>
    </link>

    <link name="second_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy=" 0 0 0"/>
            <material name="polished_gold">
            </material>
        </visual>
    </link>


    <!-- Fixed Joint-->
    <joint name="base_second_joint" type="fixed">
        <parent link="base_link"/>
        <child link="second_link"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>



    <!-- Revolute Joint -->
    <joint name="base_second_joint" type="revolute">
        <parent link="base_link"/>
        <child link="second_link"/>
        <limit lower="-1.57" upper="1.57" effort="30" velocity="1.0"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- Continuous Joint -->
    <joint name="base_second_joint" type="continuous">
        <parent link="base_link"/>
        <child link="second_link"/>
        <limit effort="30" velocity="1.0"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>


    <!-- Prismatic Joint -->
    <joint name="base_second_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="second_link"/>
        <limit lower="-0.15" upper="0.15" effort="10" velocity="1.0"/>
        <axis xyz="1 0 0"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>

    <!-- Prismatic either Overrides everything before it - VS Code integrated URDF viewer. URDF Crashes in RVIZ as single joint is configured multiple times, different ways !-->


    


</robot>