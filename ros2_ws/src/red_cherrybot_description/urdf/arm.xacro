<?xml version="1.0"?>
<robot name="Red_Cherry_Bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="arm_base_length" value="0.1"/>
    <xacro:property name="arm_base_width" value="0.1"/>
    <xacro:property name="arm_base_height" value="0.04"/>
    <xacro:property name="arm_base_mass" value="0.5"/>

    <xacro:property name="arm_radius" value="0.02"/>
    <xacro:property name="arm_height" value="0.3"/>   
    <xacro:property name="arm_mass" value="0.3"/> 

    <!-- File will be included in model.urdf.xacro, so will get access to all links, props and joints, materials-->
    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2.0}" rpy="0 0 0"/>
            <material name="base_orange"/>
        </visual>

        <collision>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:box_inertia m="${arm_base_mass}" x="${arm_base_length}" y="${arm_base_width}" z="${arm_base_height}" o_xyz="0 0 ${arm_base_height/2.0}" o_rpy="0 0 0"/>
    </link> 

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_height/2.0}" rpy="0 0 0"/>
            <material name="golden_yellow"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_height/2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="${arm_mass}" r="${arm_radius}" l="${arm_height}" o_xyz="0 0 ${arm_height/2.0}" o_rpy="0 0 0"/>

    </link>

    <link name="elbow_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_height/2.0}" rpy="0 0 0"/>
            <material name="elbow_blue"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_height}"/>
            </geometry>
            <origin xyz="0 0 ${arm_height/2.0}" rpy="0 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="${arm_mass}" r="${arm_radius}" l="${arm_height}" o_xyz="0 0 ${arm_height/2.0}" o_rpy="0 0 0"/>
    </link>


    <!-- Joints -->
    <joint name="arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="${base_length/4.0} 0 ${base_height}" rpy="0 0 0"/>
    </joint>

    <joint name="forearm_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="forearm_link"/>
        <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100" lower="0" upper="1.57"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <joint name="elbow_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="elbow_link"/>
        <origin xyz="0 0 ${arm_height}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100" lower="0" upper="1.57"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

</robot>