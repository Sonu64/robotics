<?xml version="1.0"?>
<robot name="Red_Cherry_Bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.1"/>
    <xacro:property name="base_width" value="0.1"/>
    <xacro:property name="base_height" value="0.04"/> <!-- height in doc was 0.02 or 0.01-->
    <xacro:property name="base_mass" value="0.5"/>

    <xacro:property name="arm_radius" value="0.02"/>
    <xacro:property name="arm_height" value="0.3"/>   
    <xacro:property name="arm_mass" value="0.3"/> 

    <!-- File will be included in model.urdf.xacro, so will get access to all links, props and joints, materials-->
    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="base_orange"/>
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>

        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link> 



    <!-- Joints -->
    <joint name="arm_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <!-- Warning, 0.4 is hardcoded here, should not have been ! I donno why ${base_height} is not working ! --> 
    </joint>

</robot>