<?xml version="1.0"?>
<robot name="Red_Cherry_Bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.05"/>
    <xacro:property name="camera_width" value="0.2"/>
    <xacro:property name="camera_height" value="0.2"/>

  <!-- File will be included in model.urdf.xacro, so will get access to all links, props and joints, materials-->

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_yellow"/>
    </visual>

    <collision>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <xacro:box_inertia m="1" x="${camera_length}" y="${camera_width}" z="${camera_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    <!-- mass is in KG, so put realistic values though its Simulation. Here its 10Kg -->
  </link>


  <joint name="base_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${(base_length + camera_length)/2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
  </joint>

</robot>