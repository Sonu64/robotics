<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Vibrant & Metallic Material Palette -->
    <material name="cherry_light_red">
        <!-- Bright, vibrant cherry red with high saturation -->
        <color rgba="0.85 0.09 0.21 1.0" />
    </material>

    <material name="bright_white">
        <!-- Bright White finish -->
        <color rgba="1 1 1 1.0"/>
    </material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
               <mass value="${m}"/>
               <origin xyz="${o_xyz}" rpy="${o_rpy}"/>        
               <inertia 
                    ixx="${ (m/12.0) * (y*y + z*z) }" ixy="0" ixz="0" 
                    iyy="${ (m/12.0) * (x*x + z*z) }" iyz="0" 
                    izz="${ (m/12.0) * (x*x + y*y) }"/>        
        </inertial>
    </xacro:macro>

    <xacro:macro name="wheel_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia
                ixx="${ (m/12.0) * (3.0*r*r + l*l) }" ixy="0" ixz="0"
                iyy="${ (m/12.0) * (3.0*r*r + l*l) }" iyz="0"
                izz="${ (m/12.0) * (3.0*r*r + l*l) }" />
        </inertial>
    </xacro:macro>


    <xacro:macro name="caster_wheel_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia
                ixx="${ (2.0/5.0) * m * r * r }" ixy="0" ixz="0"
                iyy="${ (2.0/5.0) * m * r * r }" iyz="0"
                izz="${ (2.0/5.0) * m * r * r }" />
        </inertial>
    </xacro:macro>



</robot>