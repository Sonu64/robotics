<launch>
    <let name="urdf_path" 
    value="$(find-pkg-share red_cherrybot_description)/urdf/model.urdf.xacro" />


    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">  
        <param name="robot_description" 
               value="$(command 'xacro $(var urdf_path)')" />
    </node>


    <!-- Joint State Publisher GUI -->
    <!--<node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />-->
    

    <!-- RViz2 with parameters -->
    <node pkg="rviz2" exec="rviz2" output="screen" 
    args="-d $(find-pkg-share red_cherrybot_description)/rviz/urdf_config.rviz"
    />

    <!-- Gazebo Simulation with ROS2 launch option, needs includes -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="empty.sdf -r"/>
    </include>

    <!-- Spawn the robot in gazebo -->
    <node pkg="ros_gz_sim" exec="create" output="screen"
        args="-topic robot_description"       
    />

</launch>