<launch>

    <node pkg="my_python_pkg" exec="number_publisher" name="renamed_number_publisher" namespace="/abcdNS">
      <remap from="number" to="renamed_number"/>

      <!-- removed slashes above to remap with namespaces as well -->
      <!-- <param name="count" value="10000"/>
      <param name="timer_period" value="3.0"/> -->
      <param from="$(find-pkg-share my_robot_bringup)/config/number_params.yaml"/>
    </node>


    <node pkg="my_cpp_pkg" exec="number_counter" name="renamed_number_counter" namespace="/abcdNS">
        <remap from="number" to="renamed_number"/>
        <remap from="number_count" to="renamed_number_count"/>
    </node>

</launch>